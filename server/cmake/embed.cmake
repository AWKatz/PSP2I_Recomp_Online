# cmake -DOUT=web_assets.c -DIN_DIR=server/web -P embed.cmake
# The admin panel's files as C arrays (the server is one executable).
set(src "/* Generated by server/cmake/embed.cmake from server/web -- do not edit. */\n")
foreach(entry index.html:WEB_INDEX_HTML app.js:WEB_APP_JS app.css:WEB_APP_CSS)
    string(REPLACE ":" ";" parts ${entry})
    list(GET parts 0 file)
    list(GET parts 1 sym)
    file(READ "${IN_DIR}/${file}" hex HEX)
    string(LENGTH "${hex}" hl)
    math(EXPR n "${hl} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){24})" "\\1\n" bytes "${bytes}")
    string(APPEND src "const unsigned char ${sym}[] = {\n${bytes}0x00};\nconst unsigned int ${sym}_LEN = ${n};\n")
endforeach()
file(WRITE "${OUT}.tmp" "${src}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
